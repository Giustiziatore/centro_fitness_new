DB_URL=jdbc:mysql://localhost:3306/centro_fitness?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-local-db-password

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

CORS_ALLOWED_ORIGINS=http://localhost:4200

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-development-password
ADMIN_EMAIL=admin@fitness.local

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_SQL_LOG_LEVEL=INFO
HIBERNATE_BINDER_LOG_LEVEL=INFO

SERVER_ERROR_INCLUDE_MESSAGE=always
SERVER_ERROR_INCLUDE_BINDING_ERRORS=always
